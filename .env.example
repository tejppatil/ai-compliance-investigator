# ── AI Compliance Investigator — configuration ──────────────────────────────
# Fully local, fully offline. No API key of any kind is required or used.
#
# Anomaly detection and risk scoring are ALWAYS deterministic Python — never
# the LLM. The Investigation Agent's narrative uses a local Ollama model when
# reachable and falls back to a deterministic template otherwise; both paths
# always produce a complete case (run `python scripts/setup_models.py` once
# to install Ollama and pull the two models below).
OLLAMA_HOST=http://localhost:11434
ACI_LLM_MODEL=qwen3:4b
ACI_EMBED_MODEL=nomic-embed-text
ACI_LLM_TIMEOUT_S=45

# SQLite persistence — a single local file, no server to run.
ACI_DATA_DIR=./data_local
ACI_DB_PATH=./data_local/aci.db
